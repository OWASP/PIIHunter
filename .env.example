# PostgreSQL Connection (Read-Only Role)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=pii_scanner_readonly
DB_PASSWORD=your_secure_password
DB_SSLMODE=require

# Scanning Configuration
SCHEMAS_TO_SCAN=public,app_data
SCHEMAS_TO_EXCLUDE=pg_catalog,information_schema,pg_toast
SAMPLE_SIZE=1000
BATCH_SIZE=500
MAX_WORKERS=4

# PII Detection Settings
CONFIDENCE_THRESHOLD=0.5
ENABLE_REGEX_DETECTION=true
ENABLE_NER_DETECTION=true
ENABLE_LLM_DETECTION=false

# LLM Configuration (Self-Hosted Only)
# LLM_ENDPOINT=http://localhost:8000/v1
# LLM_API_KEY=your_private_key
# LLM_MODEL=llama-2-7b

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Jira Integration ───────────────────────────────────────────────────────

# Generate your API token at: id.atlassian.com → Security → API tokens
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your_api_token

# Projects to watch — leave unset to scan ALL accessible projects
# JIRA_PROJECT_KEYS=ENG,OPS,SUPPORT

# Emails from these domains will NOT be flagged as PII
COMPANY_EMAIL_DOMAINS=yourcompany.com,internal.yourcompany.com

# Webhook server (real-time scanning)
# JIRA_WEBHOOK_SECRET=your_webhook_secret
JIRA_WEBHOOK_PORT=8080
